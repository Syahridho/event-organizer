@startuml
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  FontColor black
  RoundedCorner 25
  ArrowColor #1A5276
  ArrowFontColor black
}

start
:User Mendaftar & Login ke Sistem;
:Mitra (EO) Membuat & Mengunggah Data Event;
:Mitra Membuat & Mengunggah Data Jasa (Service);
:Mitra Membuat & Mengunggah Data Gedung;
:Mitra Membuat & Mengunggah Data Properti;
:User Menjelajahi & Mencari Event/Jasa/Properti;
:User Menambahkan Item ke Keranjang (Cart);
:Sistem Validasi Ketersediaan & Jadwal;
:User Melakukan Checkout;
:Sistem Membuat Transaksi & Generate Snap Token;
:User Melakukan Pembayaran via Midtrans;
:Midtrans Payment Gateway Memproses Pembayaran;
:Midtrans Mengirim Callback ke Sistem;
:Sistem Update Status Transaksi;
:Notifikasi Dikirim ke User & Mitra;
:Mitra Memproses Pesanan (Confirm/Process/Complete);
:User Memberikan Review & Rating;
:Admin Melakukan Monitoring & Validasi;
:Sistem Menyimpan Laporan Transaksi;
stop
@enduml