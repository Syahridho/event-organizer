@startuml
'Style agar rapi seperti laporan
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor black
skinparam SwimlaneBorderColor black
skinparam SwimlaneTitleFontWeight bold

title Diagram Aktivitas Sistem (Pelanggan/Customer)

|Otentikasi|
start
:Masuk / Daftar;

|Katalog|
:Jelajahi (Browse);
:Cari (Search);
:Lihat Detail;

|Pesanan|
:Tambah ke Keranjang;
:Checkout;
note right
  Hitung ongkir via RajaOngkir
  saat checkout
end note

|Pembayaran|
:Proses Pembayaran (Midtrans);
note right
  Integrasi Midtrans
  (token/status/webhook)
end note

if (Pembayaran Berhasil?) then (ya)
  |Notifikasi|
  :Kirim Konfirmasi;
  note right
    Email/Push Notification dikirim
  end note
else (tidak)
  |Notifikasi|
  :Kirim Info Gagal/Coba Lagi;
endif

stop
@enduml