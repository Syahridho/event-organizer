@startuml
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  FontColor black
  RoundedCorner 25
  ArrowColor #1A5276
  ArrowFontColor black
}

start
:User Login ke Sistem;
note right: Authenticated user

:User Menambahkan Item ke Keranjang;
note right: Cart::store() validation

:User Melakukan Checkout;
note right: CheckoutController::index()

:Sistem Validasi Item di Keranjang;
note right: 
  - Cek banned events
  - Cek double booking
  - Cek mitra leave schedule
  - Cek ticket quota

if (Validasi Gagal?) then (Ya)
  :Tampilkan Pesan Error;
  :User Kembali ke Keranjang;
  stop
else (Tidak)
  :Tampilkan Halaman Checkout;
  note right: TaxHelper::getTaxInfo()
endif

:User Konfirmasi Pesanan;
note right: Submit checkout form

:Sistem Buat Transaksi Baru;
note right: 
  - Generate order_id: ORD-YYYYMMDDHHMMSS-XXXXXX
  - Status: pending
  - Simpan ke transactions table

:Sistem Simpan Transaction Items;
note right: 
  - Simpan ke transaction_items
  - Link ke item asli (ticket/service/building/property)
  - Include rent_days, delivery_type, qty

:Sistem Generate Midtrans Snap Token;
note right: MidtransController::createSnapToken()
  - Hitung total dengan pajak
  - Kirim ke Midtrans API
  - Terima snap_token

:User Redirect ke Halaman Pembayaran;
note right: Midtrans Snap Page

:User Pilih Metode Pembayaran;
note right: VA, E-wallet, Credit Card, dll

:User Selesaikan Pembayaran;
note right: Input payment details

:Midtrans Proses Pembayaran;
note right: Payment gateway processing

:Midtrans Kirim Callback ke Sistem;
note right: POST /midtrans/callback

if (Signature Valid?) then (Tidak)
  :Log Error - Invalid Signature;
  :Tolak Callback;
  stop
else (Ya)
  :Proses Callback;
endif

if (Transaction Status?) then (Pending)
  :Update Status = Pending;
  :Simpan VA Number/Bank Info;
  :Kirim Notifikasi Menunggu Pembayaran;
elseif (Settlement/Capture)
  :Update Status = Settlement;
  :Simpan Payment Info;
  
  if (Order ID mulai 'DEL-ORD'?) then (Ya)
    :Ini Transaksi Biaya Antar;
    :Update delivery_fee_status di item utama;
    :Kirim Notifikasi Biaya Antar Dibayar;
  else (Tidak)
    :Ini Transaksi Utama;
    :Kurangi Kuota Tiket;
    :Batalkan Transaksi Lain yang Konflik;
    :Kirim Notifikasi Pembayaran Berhasil;
    :Kirim Notifikasi ke Mitra;
  endif
elseif (Cancel/Expire/Deny)
  :Update Status = Cancelled/Expired;
  :Kirim Notifikasi Pembatalan;
  :Kirim Notifikasi ke Mitra;
endif

:User Redirect ke Halaman Status;
note right: /midtrans/finish?order_id=XXX

if (Status Settlement?) then (Ya)
  :Tampilkan Halaman Sukses;
  :User Lihat Detail Pesanan;
else (Tidak)
  :Tampilkan Halaman Gagal/Pending;
  :User Lihat Info Pembayaran;
endif

:Mitra Melihat Pesanan Baru;
note right: Dashboard mitra

:Mitra Proses Pesanan;
note right: 
  - Confirm → Process → Complete
  - Input biaya antar (jika delivery)

if (Delivery Type = Delivery?) then (Ya)
  :Mitra Input Biaya Antar;
  :Sistem Buat Transaksi Biaya Antar;
  note right: Order ID: DEL-ORD-XXXXXX
  :User Bayar Biaya Antar;
  :Mitra Proses Pengiriman;
else (Tidak)
  :User Ambil Item (Pickup);
endif

:User Terima Item/Jasa;
note right: Order completed

:User Berikan Review & Rating;
note right: ReviewController::store()

:Mitra Request Penarikan Dana;
note right: WithdrawController::store()

:Admin Approve Penarikan;
note right: AdminWithdrawController::complete()

stop
@enduml